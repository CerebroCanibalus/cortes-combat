# ═══ COMPAT: Epic Knights ═══════════════════════════════════════════════════
# Epic Knights adds medieval weapons in multiple materials.
# Item IDs: epic_knights:<material>_<weapon>
# Materials: bronze, copper, iron, gold, diamond, netherite, silver, steel, tin
# Weapons: ahlspiess, bastardsword, chainmorgenstern, chivalrylance, claymore,
#          concavehalberd, estoc, flamebladedsword, guisarme, heavymace,
#          heavywarhammer, katzbalger, lochaberaxe, lucernhammer, morgenstern,
#          pike, ranseur, shortsword, stylet, zweihander
#
# This file covers iron/diamond/netherite for each weapon type.
# Copy to config/cortescombat/weapons/, rename to .yaml, and adjust.

version: 1

weapons:
  # ── Shortsword (fast, single-target) ──
  - match: { id: "epic_knights:iron_shortsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 35 } }
    reach: { distance: 3.0 }
    cone: { horizontal: 24, vertical: 20 }
    special: none

  - match: { id: "epic_knights:diamond_shortsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 35 } }
    reach: { distance: 3.2 }
    cone: { horizontal: 24, vertical: 20 }
    special: none

  # ── Bastardsword (heavy, wide) ──
  - match: { id: "epic_knights:iron_bastardsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.8, full_charge_ticks: 45 } }
    reach: { distance: 3.6 }
    cone: { horizontal: 32, vertical: 24 }
    special: none

  - match: { id: "epic_knights:diamond_bastardsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.8, full_charge_ticks: 45 } }
    reach: { distance: 3.8 }
    cone: { horizontal: 32, vertical: 24 }
    special: none

  # ── Claymore (wide, heavy) ──
  - match: { id: "epic_knights:iron_claymore" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.8, full_charge_ticks: 45 } }
    reach: { distance: 3.8 }
    cone: { horizontal: 36, vertical: 26 }
    special: none

  # ── Zweihander (heavy, very wide) ──
  - match: { id: "epic_knights:iron_zweihander" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 50 } }
    reach: { distance: 4.0 }
    cone: { horizontal: 40, vertical: 28 }
    special: none

  # ── Estoc (thrust, rapier) ──
  - match: { id: "epic_knights:iron_estoc" }
    archetype: rapier
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 35 } }
    reach: { distance: 3.4 }
    cone: { horizontal: 16, vertical: 14 }
    special: lunge

  - match: { id: "epic_knights:diamond_estoc" }
    archetype: rapier
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 35 } }
    reach: { distance: 3.6 }
    cone: { horizontal: 16, vertical: 14 }
    special: lunge

  # ── Flamebladed Sword (sword) ──
  - match: { id: "epic_knights:iron_flamebladedsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 40 } }
    reach: { distance: 3.4 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  # ── Katzbalger (fast, dagger-like) ──
  - match: { id: "epic_knights:iron_katzbalger" }
    archetype: dagger
    stats: { charge: { can_charge: false } }
    reach: { distance: 2.6 }
    cone: { horizontal: 22, vertical: 18 }
    special: none

  # ── Concave Halberd (polearm, sweep) ──
  - match: { id: "epic_knights:iron_concavehalberd" }
