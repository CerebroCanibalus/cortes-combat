# ═══ COMPAT: Spartan Weaponry Unofficial ════════════════════════════════════
# Spartan Weaponry adds 18 weapon types in 18+ materials.
# Item IDs: spartanweaponry:<material>_<weapon>
# Materials: wood, stone, copper, iron, golden, diamond, netherite,
#            bronze, steel, tin, lead, silver, electrum, nickel, invar,
#            constantan, aluminum, platinum
# Weapons: battle_hammer, battleaxe, dagger, flanged_mace, glaive, greatsword,
#          halberd, katana, lance, longsword, parrying_dagger, pike,
#          quarterstaff, rapier, saber, scythe, spear, warhammer
#
# This file covers iron/diamond/netherite for each weapon type.
# Copy to config/cortescombat/weapons/, rename to .yaml, and adjust.

version: 1

weapons:
  # ── Daggers (fast, no charge, no special) ──
  - match: { id: "spartanweaponry:iron_dagger" }
    archetype: dagger
    stats: { charge: { can_charge: false } }
    reach: { distance: 2.4 }
    cone: { horizontal: 20, vertical: 16 }
    special: none

  - match: { id: "spartanweaponry:diamond_dagger" }
    archetype: dagger
    stats: { charge: { can_charge: false } }
    reach: { distance: 2.6 }
    cone: { horizontal: 20, vertical: 16 }
    special: none

  - match: { id: "spartanweaponry:netherite_dagger" }
    archetype: dagger
    stats: { charge: { can_charge: false } }
    reach: { distance: 2.8 }
    cone: { horizontal: 20, vertical: 16 }
    special: none

  # ── Katanas (fast, single-target) ──
  - match: { id: "spartanweaponry:iron_katana" }
    archetype: sabre
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.0 }
    cone: { horizontal: 22, vertical: 18 }
    special: none

  - match: { id: "spartanweaponry:diamond_katana" }
    archetype: sabre
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.2 }
    cone: { horizontal: 22, vertical: 18 }
    special: none

  - match: { id: "spartanweaponry:netherite_katana" }
    archetype: sabre
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.4 }
    cone: { horizontal: 22, vertical: 18 }
    special: none

  # ── Sabers (fast, single-target) ──
  - match: { id: "spartanweaponry:iron_saber" }
    archetype: sabre
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.0 }
    cone: { horizontal: 24, vertical: 20 }
    special: none

  # ── Rapiers (thrust, lunge) ──
  - match: { id: "spartanweaponry:iron_rapier" }
    archetype: rapier
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 35 } }
    reach: { distance: 3.2 }
    cone: { horizontal: 16, vertical: 14 }
    special: lunge

  - match: { id: "spartanweaponry:diamond_rapier" }
    archetype: rapier
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 35 } }
    reach: { distance: 3.4 }
    cone: { horizontal: 16, vertical: 14 }
    special: lunge

  - match: { id: "spartanweaponry:netherite_rapier" }
    archetype: rapier
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 35 } }
    reach: { distance: 3.6 }
    cone: { horizontal: 16, vertical: 14 }
    special: lunge

  # ── Longswords (sword, single-target) ──
  - match: { id: "spartanweaponry:iron_longsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 40 } }
    reach: { distance: 3.4 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  - match: { id: "spartanweaponry:diamond_longsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 40 } }
    reach: { distance: 3.6 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  - match: { id: "spartanweaponry:netherite_longsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.5, full_charge_ticks: 40 } }
    reach: { distance: 3.8 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  # ── Greatswords (heavy, wide) ──
  - match: { id: "spartanweaponry:iron_greatsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.8, full_charge_ticks: 50 } }
    reach: { distance: 3.8 }
    cone: { horizontal: 35, vertical: 25 }
    special: none

  - match: { id: "spartanweaponry:diamond_greatsword" }
    archetype: sword
    stats: { charge: { can_charge: true, bonus: 0.8, full_charge_ticks: 50 } }
    reach: { distance: 4.0 }
    cone: { horizontal: 35, vertical: 25 }
    special: none

  # ── Glaives (polearm, sweep) ──
  - match: { id: "spartanweaponry:iron_glaive" }
    archetype: polearm
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.6 }
    cone: { horizontal: 38, vertical: 26 }
    special: multi_hit

  - match: { id: "spartanweaponry:diamond_glaive" }
    archetype: polearm
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.8 }
    cone: { horizontal: 38, vertical: 26 }
    special: multi_hit

  # ── Halberds (polearm, sweep) ──
  - match: { id: "spartanweaponry:iron_halberd" }
    archetype: polearm
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.8 }
    cone: { horizontal: 40, vertical: 28 }
    special: multi_hit

  - match: { id: "spartanweaponry:diamond_halberd" }
    archetype: polearm
    stats: { charge: { can_charge: false } }
    reach: { distance: 4.0 }
    cone: { horizontal: 40, vertical: 28 }
    special: multi_hit

  # ── Spears (thrust, no lunge) ──
  - match: { id: "spartanweaponry:iron_spear" }
    archetype: spear
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.6 }
    cone: { horizontal: 16, vertical: 14 }
    special: none

  - match: { id: "spartanweaponry:diamond_spear" }
    archetype: spear
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.8 }
    cone: { horizontal: 16, vertical: 14 }
    special: none

  # ── Pikes (thrust, no lunge, longer) ──
  - match: { id: "spartanweaponry:iron_pike" }
    archetype: spear
    stats: { charge: { can_charge: false } }
    reach: { distance: 4.0 }
    cone: { horizontal: 14, vertical: 12 }
    special: none

  # ── Scythes (polearm, sweep) ──
  - match: { id: "spartanweaponry:iron_scythe" }
    archetype: polearm
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.6 }
    cone: { horizontal: 36, vertical: 24 }
    special: multi_hit

  # ── Battle Axes (heavy) ──
  - match: { id: "spartanweaponry:iron_battleaxe" }
    archetype: axe
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 50 } }
    reach: { distance: 3.2 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  # ── Warhammers (heavy, charge) ──
  - match: { id: "spartanweaponry:iron_warhammer" }
    archetype: hammer
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 60 } }
    reach: { distance: 3.0 }
    cone: { horizontal: 26, vertical: 20 }
    special: none

  # ── Battle Hammers (heavy, charge) ──
  - match: { id: "spartanweaponry:iron_battle_hammer" }
    archetype: hammer
    stats: { charge: { can_charge: true, bonus: 1.0, full_charge_ticks: 60 } }
    reach: { distance: 3.2 }
    cone: { horizontal: 28, vertical: 22 }
    special: none

  # ── Quarterstaves (fast, no charge) ──
  - match: { id: "spartanweaponry:iron_quarterstaff" }
    archetype: dagger
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.0 }
    cone: { horizontal: 24, vertical: 20 }
    special: none

  # ── Lances (thrust, no charge) ──
  - match: { id: "spartanweaponry:iron_lance" }
    archetype: spear
    stats: { charge: { can_charge: false } }
    reach: { distance: 3.8 }
    cone: { horizontal: 14, vertical: 12 }
    special: none

  # NOTE: Add more materials (bronze, steel, etc.) and weapons (flanged_mace,
  # parrying_dagger, tomahawk, etc.) following the same pattern.
  # Full list: https://www.minecraft-guides.com/mod/spartan-weaponry/